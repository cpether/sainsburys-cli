# Nonsecret reference only. Export variables in your terminal; .env files are not auto-loaded.
SAINSBURYS_EMAIL=you@example.com
# Never put a password here. Enter it in the login browser, or store it in the
# macOS Keychain with `auth auto-sign-in enable`. MFA codes are always manual.
# SAINSBURYS_AUTO_SIGN_IN=off   # disables every Keychain access
# SAINSBURYS_SESSION_PATH=/absolute/private/directory/session.json
# Explicit override if account/reservation does not provide a store:
# SAINSBURYS_STORE_NUMBER=0123

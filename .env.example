SAINSBURYS_EMAIL=you@example.com
# Always quote the password — dotenv treats unquoted '#' as a comment and will silently truncate.
SAINSBURYS_PASSWORD='your-password'

# Optional: override session file location (default: ~/.config/sainsburys/session.json)
# SAINSBURYS_SESSION_PATH=/custom/path/session.json

# Optional: override store number used for basket/product calls (default: pulled from session)
# SAINSBURYS_STORE_NUMBER=2168

# Optional: run Playwright headed for debugging (default: headless)
# SAINSBURYS_HEADED=1

# Optional: Beeper/Matrix room that receives Sainsbury's SMS MFA codes (via the Google Messages
# bridge or similar). If set, the CLI polls `con chat messages <id>` for a fresh code instead of
# prompting on stdin — required for unattended re-auth.
# SAINSBURYS_MFA_CHAT_ROOM_ID=!yourSmsRoomId:beeper.local

# Optional: path to the `con` CLI binary (default: `con` on PATH).
# SAINSBURYS_CON_BIN=con

{
  "name": "sainsburys-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Personal Sainsbury's basket preparation with manual checkout",
  "keywords": [
    "sainsburys",
    "groceries",
    "cli",
    "agent",
    "automation"
  ],
  "author": "Yousef Amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpether/sainsburys-cli.git"
  },
  "homepage": "https://github.com/cpether/sainsburys-cli#readme",
  "bugs": "https://github.com/cpether/sainsburys-cli/issues",
  "bin": {
    "sainsburys": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "node --import ./test/isolate.mjs --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}

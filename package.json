{
  "name": "sainsburys-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-friendly CLI for Sainsbury's Groceries Online — baskets, orders, slots, checkout",
  "keywords": ["sainsburys", "groceries", "cli", "agent", "automation"],
  "author": "Yousef Amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yousefamar/sainsburys-cli.git"
  },
  "homepage": "https://github.com/yousefamar/sainsburys-cli#readme",
  "bugs": "https://github.com/yousefamar/sainsburys-cli/issues",
  "bin": {
    "sainsburys": "./dist/cli/index.js"
  },
  "files": ["dist", "README.md", "LICENSE", ".env.example"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
